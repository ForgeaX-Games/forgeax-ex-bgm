{
  "packageManager": "bun@1.3.14",
  "name": "@forgeax-extension/bgm",
  "private": false,
  "version": "0.6.3",
  "type": "module",
  "description": "ForgeaX extension: generate voice/BGM/SFX, shape a selected take, and bind it to game events. Shared by humans and AI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ForgeaX-Games/forgeax-ex-bgm.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "forgeax-extension.json",
    "library",
    "marketplace-card.json",
    "runtime",
    "schemas",
    "server",
    "shared",
    "skills",
    "!runtime/**/*.test.ts",
    "!server/**/*.test.ts",
    "!shared/**/*.test.ts"
  ],
  "scripts": {
    "dev": "vite --host",
    "build:runtime": "node ./scripts/build-runtime.mjs",
    "index:starter-library": "bun ./scripts/build-starter-library.ts",
    "check:starter-library": "bun ./scripts/build-starter-library.ts --check",
    "build:server": "bun ./scripts/build-server.mjs",
    "build": "bun run build:runtime && bun run check:starter-library && tsc --noEmit && vite build && bun run build:server",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:release": "bun test scripts/release-contract.test.ts && node scripts/check-release.mjs"
  },
  "devDependencies": {
    "dts-bundle-generator": "^9.5.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
