{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forgeax://plugin/forgeax-bgm/generate-audio-assets.args",
  "title": "generate-audio-assets args",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "items"],
  "properties": {
    "slug": { "type": "string", "minLength": 1, "maxLength": 64 },
    "concurrency": { "type": "integer", "minimum": 1, "maximum": 3, "default": 2 },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventId", "name", "kind", "prompt"],
        "properties": {
          "eventId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "assetId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "kind": { "type": "string", "enum": ["bgm", "sfx", "voice"] },
          "prompt": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "durationSeconds": { "type": "number", "minimum": 1, "maximum": 120 },
          "instrumental": { "type": "boolean", "default": true },
          "loop": { "type": "boolean", "default": false },
          "speed": { "type": "number", "minimum": 0.5, "maximum": 2 },
          "filename": { "type": "string", "maxLength": 220 },
          "format": { "type": "string", "enum": ["mp3", "wav"], "default": "mp3" }
        }
      }
    }
  }
}
